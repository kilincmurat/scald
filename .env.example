# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=scald_dev
DATABASE_URL=postgresql+asyncpg://scald:scald_dev@localhost:5432/scald

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ─────────────────────────────────────────────────────────────────
# Üretimde MUTLAKA değiştirin:  openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Backend'in doğruladığı Supabase access token'larının imza anahtarı.
# Self-hosted Supabase docker .env'indeki JWT_SECRET ile AYNI değer olmalı.
# Boş bırakılırsa korumalı API endpoint'leri fail-closed (503) döner.
SUPABASE_JWT_SECRET=

# CORS: virgülle değil, JSON dizi olarak ver. Üretimde SADECE gerçek origin(ler).
# '*' KULLANMAYIN (allow_credentials=true ile birlikte güvenlik açığıdır).
ALLOWED_ORIGINS=["http://localhost:3000"]

# Üretimde Swagger/Redoc'u kapalı tutar; asla true bırakmayın.
DEBUG=false
ENVIRONMENT=production

# ─── MinIO / Object Storage ───────────────────────────────────────────────────
MINIO_ACCESS_KEY=scald_minio
MINIO_SECRET_KEY=scald_minio_secret
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=scald

# ─── AI / Anthropic ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_SERVICE_URL=http://localhost:8001

# ─── Next.js Public ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token-here
NEXT_PUBLIC_MINIO_HOST=localhost

# ─── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
