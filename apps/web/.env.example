# ── SCALD web ─────────────────────────────────────────────────────────────────
# Copy to .env.local for development. In production these are passed to
# `docker build` (see apps/web/Dockerfile), NOT to `docker run` — Next.js
# inlines NEXT_PUBLIC_* into the client bundle and the middleware at BUILD time.
# Changing them means rebuilding the image.

# Self-hosted Supabase: the PUBLIC Kong URL, reachable from the browser.
# Not an internal container name — the browser resolves this, not the server.
#   self-hosted: https://api.scald.ktu.edu.tr
#   cloud (dev): https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://api.scald.ktu.edu.tr

# anon / public key. Safe to ship to the browser: every table is behind RLS.
# Self-hosted, this is the ANON_KEY signed with your stack's JWT_SECRET.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Server-side only ──────────────────────────────────────────────────────────
# Read at RUNTIME (pass with `docker run -e` / compose env), never inlined.
# Bypasses RLS entirely — required for admin user create/delete in
# /api/admin/users. Leaking this hands over the whole database.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
