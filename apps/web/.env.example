NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=https://scald-backend.onrender.com

# Server-side only — required for admin panel user CRUD (invite/delete via /api/admin/users).
# Get from Supabase Dashboard → Settings → API → service_role key. NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
